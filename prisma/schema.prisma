// ============================================================================
// Prisma Schema — Vega CRM
// ============================================================================
// Multi-tenant CRM database schema with:
// - Tenant isolation (each tenant = a business entity, e.g., MDU, Flying Mushroom)
// - RBAC: Global roles (super_admin/admin/user) + per-company access list
// - Activity tracking: phone calls, emails, notes, tasks
// - 2FA: TOTP secrets stored per-user
// - Audit log: tracks all data modifications
// - Integration-ready: source field on activities for future Gmail/VoIP sync
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum GlobalRole {
  SUPER_ADMIN // Bryan — sees everything, manages all tenants
  ADMIN       // Tenant admin — manages users within their assigned companies
  USER         // Standard user — sees only their assigned companies
}

enum ActivityType {
  CALL
  EMAIL
  NOTE
  TASK
  MEETING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivitySource {
  MANUAL    // User logged this manually
  GMAIL     // Synced from Gmail API (future)
  VOIP      // Synced from VoIP/SIP system (future)
  IMPORT    // Bulk imported from CSV (future)
}

// ============================================================================
// TENANT — top-level isolation boundary
// ============================================================================

model Tenant {
  id          String   @id @default(cuid())
  name        String                         // e.g., "MDU Solutions", "Flying Mushroom"
  slug        String   @unique               // URL-friendly identifier
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  companies   Company[]
  userTenants UserTenant[]
  projects    Project[]
  deals       Deal[]
  pipelineStages PipelineStage[]
  customProperties CustomProperty[]
  emailMessages  EmailMessage[]
  emailTemplates EmailTemplate[]
  emailSequences EmailSequence[]
  workflows      Workflow[]
  calendarEvents CalendarEvent[]
  bookingSlots   BookingSlot[]
  tenantSettings  TenantSetting[]
  leadScoreRules  LeadScoreRule[]
  quotes          Quote[]
  leadForms       LeadForm[]
  emailCampaigns  EmailCampaign[]
  smsMessages     SmsMessage[]
  apiKeys         ApiKey[]

  @@map("tenants")
}

// ============================================================================
// USER — authentication and global role
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  globalRole    GlobalRole @default(USER)
  isActive      Boolean   @default(true)
  
  // TOTP 2FA fields
  totpSecret    String?                        // Base32-encoded TOTP secret
  totpEnabled   Boolean   @default(false)       // Whether 2FA is required for this user
  totpBackupCodes String[] @default([])         // One-time backup codes for 2FA
  
  // Session and tracking
  lastLoginAt   DateTime?
  lastLoginIp   String?
  failedLoginAttempts Int   @default(0)         // For rate limiting
  lockedUntil   DateTime?                       // Account lockout timestamp
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userTenants   UserTenant[]
  activities    Activity[]
  tasks         Task[]     @relation("TaskAssignee")
  tasksCreated  Task[]     @relation("TaskCreator")
  projects      Project[]  @relation("ProjectCreator")
  projectTasks  ProjectTask[] @relation("ProjectTaskAssignee")
  projectTasksCreated ProjectTask[] @relation("ProjectTaskCreator")
  subtasks       Subtask[]   @relation("SubtaskAssignee")
  taskComments   TaskComment[]
  
  // Google OAuth per-user (Gmail + Calendar)
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiry    DateTime?
  googleEmail          String?  // The Google email they connected
  googleScope          String?  // Scopes granted
  
  // CRM feature relations
  deals          Deal[]    @relation("DealOwner")
  dealsCreated   Deal[]    @relation("DealCreator")
  emailMessages  EmailMessage[] @relation("EmailUser")
  emailTemplates EmailTemplate[] @relation("TemplateCreator")
  workflows      Workflow[] @relation("WorkflowCreator")
  calendarEvents CalendarEvent[]
  bookingSlots   BookingSlot[] @relation("BookingOwner")
  emailSequences EmailSequence[] @relation("SequenceCreator")
  auditLogs     AuditLog[]
  notifications  Notification[]
  apiKeys        ApiKey[] @relation("ApiKeyCreator")

  @@map("users")
}

// ============================================================================
// USER_TENANT — join table for user ↔ tenant access
// ============================================================================
// Controls which tenants (business entities) a user can see.
// super_admin bypasses this and sees all tenants.
// ============================================================================

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

// ============================================================================
// COMPANY — business entities within a tenant
// ============================================================================

model Company {
  id          String   @id @default(cuid())
  tenantId    String
  name        String                              // Company name
  industry    String?
  website     String?
  phone       String?
  email       String?
  address     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  activities  Activity[]
  tasks       Task[]
  deals       Deal[]
  emailMessages EmailMessage[]
  calendarEvents CalendarEvent[]
  bookings    Booking[]

  @@index([tenantId])
  @@map("companies")
}

// ============================================================================
// CONTACT — people associated with a company
// ============================================================================

model Contact {
  id          String   @id @default(cuid())
  companyId   String
  tenantId    String                              // Denormalized for tenant filtering
  firstName   String
  lastName    String
  email       String?
  phone       String?
  mobile      String?
  title       String?                             // Job title
  department  String?
  notes       String?
  tags        String[]  @default([])               // Flexible tagging
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities  Activity[]
  tasks       Task[]
  deals       Deal[]
  emailMessages EmailMessage[]
  calendarEvents CalendarEvent[]
  sequenceEnrollments SequenceEnrollment[]
  bookings    Booking[]

  @@index([tenantId])
  @@index([companyId])
  @@map("contacts")
}

// ============================================================================
// ACTIVITY — phone calls, emails, notes, meetings
// ============================================================================

model Activity {
  id          String         @id @default(cuid())
  type        ActivityType                            // CALL, EMAIL, NOTE, MEETING
  tenantId    String                                  // Denormalized for tenant filtering
  companyId   String                                  // Which company this relates to
  contactId   String?                                 // Optional: specific contact
  userId      String                                  // Who created/logged this activity
  dealId      String?                                 // Optional: linked deal
  subject     String                                  // Title/summary
  description String?                                 // Detailed notes
  
  // Call-specific fields
  callDirection String?                               // "inbound" | "outbound"
  callDuration  Int?                                  // Duration in seconds
  callOutcome   String?                               // e.g., "answered", "voicemail", "missed"
  
  // Email-specific fields
  emailFrom   String?
  emailTo     String?
  emailCc     String?
  emailBody   String?                                 // Full email body (future: encrypted)
  
  // Source tracking — for future integrations
  source      ActivitySource @default(MANUAL)
  externalId  String?                                 // ID from external system (Gmail msg ID, SIP call ID)
  
  // Scheduling (for meetings, scheduled calls)
  scheduledAt DateTime?
  completedAt DateTime?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([companyId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([dealId])
  @@map("activities")
}

// ============================================================================
// TASK — actionable items with assignee and due date
// ============================================================================

model Task {
  id          String       @id @default(cuid())
  tenantId    String                                    // Denormalized for tenant filtering
  companyId   String                                    // Which company this task relates to
  contactId   String?                                   // Optional: specific contact
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  
  assignedToId String                                    // Who is responsible
  createdById  String                                    // Who created the task
  dueDate     DateTime?
  completedAt DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee    User        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  creator     User        @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ============================================================================
// PROJECT — kanban board container (replaces external task tracking)
// ============================================================================

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#c9a96e")            // Board accent color
  icon        String?                                  // Emoji or single-char icon
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User           @relation("ProjectCreator", fields: [createdById], references: [id])
  columns     ProjectColumn[]
  tasks       ProjectTask[]

  @@index([tenantId])
  @@map("projects")
}

// ============================================================================
// PROJECT_COLUMN — kanban columns within a project
// ============================================================================

model ProjectColumn {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  color        String   @default("#8b8d98")
  position     Int                                       // Sort order (0-based)
  wipLimit     Int?                                     // Max cards (WIP limit); null = unlimited
  isDoneColumn Boolean  @default(false)                  // Tasks moved here auto-complete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]

  @@index([projectId])
  @@map("project_columns")
}

// ============================================================================
// PROJECT_TASK — kanban cards within a column
// ============================================================================

model ProjectTask {
  id            String       @id @default(cuid())
  projectId     String
  columnId      String
  tenantId      String                                   // Denormalized for tenant filtering
  title         String
  description   String?
  position      Int                                      // Sort order within column (0-based)
  priority      TaskPriority @default(MEDIUM)
  assignedToId  String?
  createdById   String
  dueDate       DateTime?
  completedAt   DateTime?
  labels        String[]    @default([])                  // Label names (e.g., "bug", "urgent")
  color         String?                                   // Card accent / cover color
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column        ProjectColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("ProjectTaskAssignee", fields: [assignedToId], references: [id])
  creator       User           @relation("ProjectTaskCreator", fields: [createdById], references: [id])
  subtasks      Subtask[]
  comments      TaskComment[]

  @@index([projectId])
  @@index([columnId])
  @@index([tenantId])
  @@index([assignedToId])
  @@map("project_tasks")
}

// ============================================================================
// TASK_COMMENT — activity history / comments on project task cards
// ============================================================================

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  tenantId    String
  userId      String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([tenantId])
  @@map("task_comments")
}

// ============================================================================
// SUBTASK — checklist items within a project task card
// ============================================================================

model Subtask {
  id            String   @id @default(cuid())
  taskId        String
  title         String
  isCompleted   Boolean  @default(false)
  position      Int
  assignedToId  String?
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  task          ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee      User?       @relation("SubtaskAssignee", fields: [assignedToId], references: [id])

  @@index([taskId])
  @@map("subtasks")
}

// ============================================================================
// DEAL — sales opportunity in a pipeline
// ============================================================================

model Deal {
  id             String   @id @default(cuid())
  tenantId       String
  title          String
  description    String?                                // Detailed notes
  companyId      String
  contactId      String?
  stageId        String
  value          Float    @default(0)              // Deal value in USD
  currency       String   @default("USD")
  probability    Int      @default(50)             // 0-100 win probability
  expectedCloseDate DateTime?
  actualCloseDate    DateTime?
  status         DealStatus @default(OPEN)
  lossReason     String?
  leadSource      String?                           // e.g., "referral", "cold outreach", "website"
  assignedToId   String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  assignee       User         @relation("DealOwner", fields: [assignedToId], references: [id])
  creator        User         @relation("DealCreator", fields: [createdById], references: [id])
  activities     Activity[]
  emailMessages  EmailMessage[]
  quotes         Quote[]

  @@index([tenantId])
  @@index([stageId])
  @@index([assignedToId])
  @@index([status])
  @@index([companyId])
  @@map("deals")
}

// ============================================================================
// PIPELINE_STAGE — stages in a sales pipeline (per tenant)
// ============================================================================

model PipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  name        String                                  // e.g., "Lead", "Qualified", "Proposal"
  color       String   @default("#8b8d98")
  position    Int                                      // Sort order
  probability  Int     @default(0)                     // Default win probability for this stage
  isWonStage  Boolean  @default(false)                 // Deals here = won
  isLostStage Boolean  @default(false)                 // Deals here = lost
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([tenantId])
  @@map("pipeline_stages")
}

// ============================================================================
// CUSTOM_PROPERTY — user-defined fields on companies/contacts (per tenant)
// ============================================================================

model CustomProperty {
  id          String   @id @default(cuid())
  tenantId    String
  entity      String                                  // "company" or "contact"
  key         String                                  // Field key (e.g., "property_type")
  label       String                                  // Display label (e.g., "Property Type")
  fieldType   String                                  // "text", "number", "dropdown", "date", "boolean"
  options     String[] @default([])                   // Dropdown options
  isRequired  Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values      CustomPropertyValue[]

  @@index([tenantId])
  @@index([entity])
  @@map("custom_properties")
}

model CustomPropertyValue {
  id          String   @id @default(cuid())
  propertyId  String
  entityId    String                                  // company or contact ID
  value       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  property    CustomProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([entityId])
  @@map("custom_property_values")
}

// ============================================================================
// EMAIL_MESSAGE — emails sent/received via Gmail sync
// ============================================================================

model EmailMessage {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String                                  // CRM user who sent/received
  companyId     String?
  contactId     String?
  dealId        String?
  threadId      String?                                 // Gmail thread ID
  messageId     String?                                 // Gmail message ID
  direction     String                                  // "outbound" or "inbound"
  fromEmail     String
  toEmails      String[]                                // Array of recipient emails
  ccEmails      String[] @default([])
  subject       String
  bodyText      String?
  bodyHtml      String?
  isRead        Boolean  @default(false)
  isReplied     Boolean  @default(false)                // Has this outbound email been replied to?
  sentAt        DateTime?
  receivedAt    DateTime?
  syncedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User     @relation("EmailUser", fields: [userId], references: [id])
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal          Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  opens         EmailOpen[]
  clicks        EmailClick[]

  @@index([tenantId])
  @@index([userId])
  @@index([contactId])
  @@index([companyId])
  @@index([threadId])
  @@index([direction])
  @@map("email_messages")
}

// ============================================================================
// EMAIL_TEMPLATE — reusable email templates with variables
// ============================================================================

model EmailTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String                                  // "Welcome Email", "Follow-up #1"
  subject     String                                  // Subject line (with {variables})
  body        String                                  // Email body (with {variables})
  category    String?                                 // "sales", "onboarding", "support"
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User     @relation("TemplateCreator", fields: [createdById], references: [id])
  steps       SequenceStep[]

  @@index([tenantId])
  @@map("email_templates")
}

// ============================================================================
// EMAIL_SEQUENCE — multi-touch email cadence
// ============================================================================

model EmailSequence {
  id          String   @id @default(cuid())
  tenantId    String
  name        String                                  // "ISP Cold Outreach 5-Step"
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User     @relation("SequenceCreator", fields: [createdById], references: [id])
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@map("email_sequences")
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  templateId  String?
  stepNumber  Int                                     // 1, 2, 3...
  delayDays   Int      @default(0)                    // Days after previous step
  sendTime    String?                                 // "09:00" — time of day to send
  createdAt   DateTime @default(now())

  // Relations
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enrollments SequenceEnrollmentStep[]

  @@index([sequenceId])
  @@map("sequence_steps")
}

model SequenceEnrollment {
  id          String   @id @default(cuid())
  sequenceId  String
  contactId   String
  tenantId    String
  status      String   @default("ACTIVE")             // ACTIVE, COMPLETED, PAUSED, BOUNCED
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  // Relations
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  steps       SequenceEnrollmentStep[]

  @@index([sequenceId])
  @@index([contactId])
  @@index([tenantId])
  @@map("sequence_enrollments")
}

model SequenceEnrollmentStep {
  id            String    @id @default(cuid())
  enrollmentId  String
  stepId        String
  status        String    @default("PENDING")          // PENDING, SENT, SKIPPED, FAILED
  scheduledFor  DateTime?
  sentAt        DateTime?
  emailMessageId String?

  // Relations
  enrollment    SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step          SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([stepId])
  @@map("sequence_enrollment_steps")
}

// ============================================================================
// WORKFLOW — visual automation rules
// ============================================================================

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     String                                  // "deal_stage_change", "contact_created", "task_assigned", "email_received"
  triggerConfig Json?                                 // Trigger-specific config
  conditions  Json?                                   // Array of condition objects
  actions     Json                                     // Array of action objects
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User     @relation("WorkflowCreator", fields: [createdById], references: [id])
  executions  WorkflowExecution[]

  @@index([tenantId])
  @@index([trigger])
  @@map("workflows")
}

model WorkflowExecution {
  id          String   @id @default(cuid())
  workflowId  String
  entityId    String                                  // The entity that triggered it
  entityType  String                                  // "deal", "contact", "task", "email"
  status      String   @default("PENDING")            // PENDING, RUNNING, COMPLETED, FAILED
  result      Json?
  error       String?
  executedAt  DateTime?
  createdAt   DateTime @default(now())

  // Relations
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([entityType])
  @@map("workflow_executions")
}

// ============================================================================
// CALENDAR_EVENT — synced from Google Calendar
// ============================================================================

model CalendarEvent {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  googleEventId String?                                // Google Calendar event ID
  title         String
  description   String?
  location      String?
  startAt       DateTime
  endAt         DateTime
  attendees     String[] @default([])                  // Email addresses
  companyId     String?
  contactId     String?
  isAllDay      Boolean  @default(false)
  status        String   @default("CONFIRMED")         // CONFIRMED, TENTATIVE, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([startAt])
  @@map("calendar_events")
}

// ============================================================================
// BOOKING_SLOT — self-service meeting scheduler (Calendly-style)
// ============================================================================

model BookingSlot {
  id          String   @id @default(cuid())
  userId      String                                   // The CRM user accepting bookings
  tenantId    String
  dayOfWeek   Int                                      // 0=Sunday, 6=Saturday
  startTime   String                                   // "09:00"
  endTime     String                                   // "17:00"
  durationMin Int      @default(30)                    // Meeting duration
  bufferMin   Int      @default(0)                     // Buffer between meetings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation("BookingOwner", fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([userId])
  @@index([tenantId])
  @@map("booking_slots")
}

model Booking {
  id          String   @id @default(cuid())
  bookingSlotId String
  slotId      String                                  // Kept for backward compatibility with existing data
  contactId   String?
  contactName String?
  contactEmail String?
  contactPhone String?
  companyId   String?
  notes       String?
  scheduledAt DateTime?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("PENDING")             // PENDING, CONFIRMED, CANCELLED, COMPLETED
  googleEventId String?                                // Created Google Calendar event
  createdAt   DateTime @default(now())

  // Relations
  slot        BookingSlot @relation(fields: [bookingSlotId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([bookingSlotId])
  @@index([slotId])
  @@index([contactId])
  @@map("bookings")
}

// ============================================================================
// AUDIT LOG — tracks all data modifications for compliance
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String                                 // "create", "update", "delete"
  entity    String                                 // "company", "contact", "activity", "task", "user"
  entityId  String
  changes   Json?                                  // Before/after diff
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
// ============================================================================
// TENANT_SETTING — per-tenant key-value settings store for integrations
// ============================================================================

model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String                         // e.g., "google_oauth_client_id"
  value       String                         // encrypted or plaintext value
  isEncrypted Boolean  @default(false)        // marks sensitive values
  updatedAt   DateTime @updatedAt
  updatedBy   String?                         // userId of last editor

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

// ============================================================================
// NOTIFICATION — in-app notifications for users
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String                          // Who sees this notification
  type        String                          // "TASK_OVERDUE", "DEAL_STAGE_CHANGE", "EMAIL_RECEIVED", "BOOKING_CREATED", "LEAD_CAPTURED"
  title       String
  message     String
  entityId    String?                         // ID of related object (task, deal, contact, etc.)
  entityType  String?                         // "task", "deal", "contact", "email", "booking"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// EMAIL_OPEN — tracks when a recipient opens an outbound email
// ============================================================================

model EmailOpen {
  id             String   @id @default(cuid())
  emailMessageId String
  openedAt       DateTime @default(now())
  ipAddress      String?
  userAgent      String?

  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@map("email_opens")
}

// ============================================================================
// EMAIL_CLICK — tracks link clicks within outbound emails
// ============================================================================

model EmailClick {
  id             String   @id @default(cuid())
  emailMessageId String
  url            String
  clickedAt      DateTime @default(now())
  ipAddress      String?
  userAgent      String?

  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@map("email_clicks")
}

// ============================================================================
// LEAD_SCORE_RULE — configurable scoring rules per tenant
// ============================================================================

model LeadScoreRule {
  id          String   @id @default(cuid())
  tenantId    String
  event       String                          // "EMAIL_OPENED", "DEAL_ADVANCED", "NO_ACTIVITY_30D", etc.
  points      Int                             // Positive or negative
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, event])
  @@map("lead_score_rules")
}

// ============================================================================
// QUOTE — quotes/proposals attached to deals
// ============================================================================

model Quote {
  id          String   @id @default(cuid())
  dealId      String
  tenantId    String
  number      String                          // Quote number (e.g., Q-2026-001)
  status      String   @default("DRAFT")      // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  subtotal    Float    @default(0)
  taxRate     Float    @default(0)             // Percentage (e.g., 8.5)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  notes       String?
  validUntil  DateTime?
  sentAt      DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems   QuoteLineItem[]

  @@index([dealId])
  @@index([tenantId])
  @@map("quotes")
}

// ============================================================================
// QUOTE_LINE_ITEM — line items within a quote
// ============================================================================

model QuoteLineItem {
  id          String   @id @default(cuid())
  quoteId     String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

// ============================================================================
// LEAD_FORM — embeddable lead capture forms
// ============================================================================

model LeadForm {
  id          String   @id @default(cuid())
  tenantId    String
  name        String                          // Form name (internal)
  slug        String   @unique                 // URL slug for public form
  fields      Json                             // Array of {name, label, type, required}
  redirectUrl String?                         // Where to redirect after submit
  isActive    Boolean  @default(true)
  webhookUrl  String?                         // Optional webhook on submission
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions LeadFormSubmission[]

  @@index([tenantId])
  @@map("lead_forms")
}

// ============================================================================
// LEAD_FORM_SUBMISSION — individual form submissions
// ============================================================================

model LeadFormSubmission {
  id          String   @id @default(cuid())
  formId      String
  data        Json                             // Submitted field values
  contactId   String?                          // Created contact if matched/created
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  form        LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@map("lead_form_submissions")
}

// ============================================================================
// EMAIL_CAMPAIGN — mass email campaigns
// ============================================================================

model EmailCampaign {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  subject     String
  body        String                          // HTML body
  templateId  String?                         // Optional template reference
  status      String   @default("DRAFT")      // DRAFT, SCHEDULED, SENDING, SENT, PAUSED
  audienceFilter Json?                        // Contact filter criteria
  scheduledAt DateTime?
  sentAt      DateTime?
  totalSent   Int      @default(0)
  totalOpened Int      @default(0)
  totalClicked Int     @default(0)
  totalReplied Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients  EmailCampaignRecipient[]

  @@index([tenantId])
  @@map("email_campaigns")
}

// ============================================================================
// EMAIL_CAMPAIGN_RECIPIENT — per-recipient tracking for campaigns
// ============================================================================

model EmailCampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  contactId   String?
  email       String
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  repliedAt   DateTime?
  status      String   @default("PENDING")    // PENDING, SENT, OPENED, CLICKED, REPLIED, BOUNCED

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("email_campaign_recipients")
}

// ============================================================================
// SMS_MESSAGE — SMS log for Twilio integration
// ============================================================================

model SmsMessage {
  id          String   @id @default(cuid())
  tenantId    String
  contactId   String?
  userId      String?                         // Who sent it (if outbound)
  direction   String                          // "INBOUND" or "OUTBOUND"
  body        String
  status      String   @default("PENDING")    // PENDING, SENT, DELIVERED, FAILED
  externalId  String?                         // Twilio message SID
  fromNumber  String
  toNumber    String
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("sms_messages")
}
// ============================================================================
// API_KEY — API keys for external integrations (Priority 7)
// ============================================================================
// Allows admins to generate scoped API keys for programmatic access.
// Keys are hashed (SHA-256) — plaintext shown only once at creation time.
// Scopes follow the pattern: read:resource, write:resource (e.g., read:companies).
// ============================================================================

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String?                          // null = all accessible tenants (super_admin keys)
  name        String                            // Human-readable label (e.g., "Zapier Integration")
  keyHash     String    @unique                 // SHA-256 hash of the full key
  keyPrefix   String                            // First 12 chars for identification (vga_xxxxxxxx)
  scopes      String[]                          // Array of scope strings (read:companies, write:deals, etc.)
  createdBy   String                            // User ID who created the key
  lastUsedAt  DateTime?
  lastUsedIp  String?
  expiresAt   DateTime?                         // null = no expiry
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User      @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdBy])
  @@index([keyHash])
  @@map("api_keys")
}
