# ============================================================================
# Caddyfile — Vega CRM Reverse Proxy
# ============================================================================
# Automatic HTTPS via Let's Encrypt (ACME)
# HTTP → HTTPS redirect
# Security headers
# Reverse proxy to Next.js app (vega-crm:3000)
# ============================================================================

earth.servers.onl {
    # Reverse proxy to the Next.js app
    reverse_proxy vega-crm:3000

    # Security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Compression
    encode gzip zstd

    # Logging
    log {
        output file /data/crm-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# HTTP → HTTPS redirect
http://earth.servers.onl {
    redir https://earth.servers.onl{uri} permanent
}
# ============================================================================

# ============================================================================
# ============================================================================
# MycoOS — Mushroom Cultivation SaaS (HTTPS on port 8443)
# ============================================================================

earth.servers.onl:8443 {
    tls /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.crt /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.key

    reverse_proxy mycoos-app:3000

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }

    encode gzip zstd
}

# ============================================================================
# MycoOS — Wildcard subdomain routing for tenant subdomains on port 8444
# ============================================================================
# Routes *.mycoos.earth.servers.onl to mycoos-app:3000
# Uses the same LE cert as the main earth.servers.onl domain
# ============================================================================

mycoos.earth.servers.onl:8444 {
    tls /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.crt /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.key

    reverse_proxy mycoos-app:3000

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }

    encode gzip zstd
}

*.mycoos.earth.servers.onl:8444 {
    tls /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.crt /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/earth.servers.onl/earth.servers.onl.key

    reverse_proxy mycoos-app:3000

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }

    encode gzip zstd
}

